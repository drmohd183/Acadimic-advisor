# انسخ هذا الملف إلى deploy/.env.production واملأ القيم. لا ترفع الملف المعبأ إلى أي مستودع.
APP_MODE=production
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://advisor.ptuk.edu.ps

# قاعدة البيانات (مع Docker تُستخدم DB_PASSWORD؛ دون Docker اضبط DATABASE_URL مباشرة)
DB_PASSWORD=غيّر-هذه-القيمة-لكلمة-طويلة-عشوائية
# DATABASE_URL=postgres://advisor:PASSWORD@localhost:5432/advisor

# كلمة مرور حساب admin عند التهيئة الأولى (10 أحرف على الأقل). غيّرها من الواجهة بعد أول دخول.
SEED_ADMIN_PASSWORD=

# الجلسات والكوكيز خلف HTTPS
COOKIE_SECURE=true
SESSION_HOURS=8
TRUST_PROXY=1

# حدود الطلبات لكل IP (طلبة الحرم قد يشتركون بعنوان واحد)
LOGIN_RATE_LIMIT=300
API_RATE_LIMIT=3000

# النموذج اللغوي الخارجي: معطل. لا تفعّله دون موافقة الجامعة على سياسة الخصوصية.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# الربط المستقبلي مع نظام معلومات الطلبة (Edugate) عند توفر واجهة رسمية
SIS_BASE_URL=
SIS_API_KEY=
