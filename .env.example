# اتصال قاعدة البيانات PostgreSQL
DATABASE_URL=postgres://advisor:advisor@localhost:5432/advisor
PORT=4000
# demo = نموذج تجريبي مستقل (يُظهر الحسابات التجريبية في صفحة الدخول)، production = النظام الفعلي
APP_MODE=demo
SESSION_HOURS=8
# اجعلها true عند التشغيل خلف HTTPS
COOKIE_SECURE=false
# كلمة مرور حساب الإدارة عند التهيئة (يُفضّل ضبطها؛ وإلا تُستخدم Admin@2026)
SEED_ADMIN_PASSWORD=

# النموذج اللغوي (اختياري ومعطل افتراضيًا). يتطلب أيضًا تفعيل القاعدة llmEnabled من لوحة الإدارة
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# التكامل مع نظام معلومات الطلبة (عند توفر واجهة رسمية مصرح بها)
SIS_BASE_URL=
SIS_API_KEY=

# حدود الطلبات لكل IP (طلبة الحرم قد يشتركون بعنوان واحد) وعدد الوكلاء العكسيين أمام التطبيق
LOGIN_RATE_LIMIT=300
API_RATE_LIMIT=3000
TRUST_PROXY=1
